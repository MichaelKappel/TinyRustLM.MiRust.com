profile: tinyrustlm-mirust.file-handoff.current.v2
updated_utc: 2026-08-30T02:00:51Z
current_authority: New intake is reviewed against exactly one canonical TinyRustLM.com source, clean-slate SLM2, exact two-use MemoryEndpoints.com, privacy, evidence, no-compatibility, and declared-public deployment-current invalidation contracts in totem.uai and taboo.uai.
handoff_root: agent-file-handoff/
active_buckets:
  content: agent-file-handoff/Content/
  improvement: agent-file-handoff/Improvement/
completion_gate:
  required_before_broad_work: true
  required_evidence:
    - live_bucket_scan
    - disposition_per_non_placeholder_file
    - processed_outcome
    - proof_of_use
    - durable_preservation_or_rejection_reason
    - hot_memory_update
    - source_site_removal_or_keep_active_reason
durable_targets:
  reports: docs/reports/
  report_index: docs/report-index.md
  long_term_memory_body: docs/long-term-memory.md
  pointer_ledger: .uai/long-term-memory.uai

