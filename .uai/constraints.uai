profile: tinyrustlm.constraints.v1
updated_utc: 2026-06-29T22:59:10Z
constraints:
  hard:
    - Plain PHP only; no WordPress.
    - No Bootstrap, jQuery, Tailwind, React, Vue, Composer, npm, CDN dependencies, page builders, telemetry, analytics, or remote inference APIs.
    - Keep content server-rendered or static and crawlable.
    - Keep .uai memory compact and pointer-first.
    - Keep report bodies in docs/reports.
    - Do not widen TinyRustLM source claims without source-backed evidence.
  contact:
    footer_required_text: Contact Mike Kappel
    footer_required_link: /contact/
